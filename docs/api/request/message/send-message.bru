meta {
  name: Send Message
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/msg/api/messages
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{bearerToken}}
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "text": "Hello, I am interested in your offer for Grand Hotel Paris. Is the room available for August?",
    "receiverEmail": "owner@example.com"
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
  res.body.senderEmail: isDefined
  res.body.receiverEmail: isDefined
}
