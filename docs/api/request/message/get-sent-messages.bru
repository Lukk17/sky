meta {
  name: Get Sent Messages
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/msg/api/messages/sent?page=0&size=20
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{bearerToken}}
  Accept: application/json
}

assert {
  res.status: eq 200
  res.body.content: isDefined
  res.body.totalElements: isDefined
}
