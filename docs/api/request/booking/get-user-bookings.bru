meta {
  name: Get User Bookings
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/booking/api/user/bookings?page=0&size=20
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{bearerToken}}
  Accept: application/json
}

assert {
  res.status: eq 200
  res.body.content: isDefined
  res.body.totalElements: isDefined
}
