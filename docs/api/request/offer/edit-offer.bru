meta {
  name: Edit Offer
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/offer/api/owner/offers
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{bearerToken}}
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "id": 42,
    "hotelName": "Grand Hotel Paris (Renovated)",
    "description": "Freshly renovated rooms with panoramic city views.",
    "comment": "Breakfast and spa access included.",
    "price": 299.99,
    "roomCapacity": 2,
    "city": "Paris",
    "country": "France",
    "photoPath": "/images/grand-hotel-paris-new.jpg"
  }
}

assert {
  res.status: eq 200
  res.body.id: isDefined
}
