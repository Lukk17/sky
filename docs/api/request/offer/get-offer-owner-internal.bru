meta {
  name: Get Offer Owner (Internal, direct service)
  type: http
  seq: 7
}

get {
  url: http://localhost:5552/api/internal/owner/offer/42
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{bearerToken}}
  Accept: application/json
}

assert {
  res.status: eq 200
}

# NOTE: This endpoint is NOT routed through the gateway.
# The OfferInternalController is mapped at /api/internal (not /api/v1/internal),
# so it sits outside the gateway rewrite path /offer/api/** -> /api/v1/**.
# sky-booking calls it directly at http://sky-offer-service:5552/api/internal/owner/offer/{id}.
# In production, this route is not exposed to the public internet.
# The URL above points to the service directly on its local port.
