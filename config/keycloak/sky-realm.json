{
  "realm": "sky",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      {
        "name": "admin",
        "composite": false,
        "clientRole": false,
        "containerId": "sky"
      },
      {
        "name": "user",
        "composite": false,
        "clientRole": false,
        "containerId": "sky"
      }
    ]
  },
  "clients": [
    {
      "clientId": "sky-backend",
      "name": "Sky backend services",
      "description": "Audience for the sky REST services and the local Spring Cloud Gateway login client.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "dev-only-change-in-prod",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "redirectUris": [
        "http://localhost:8080/*",
        "https://skycloud.luksarna.com/*",
        "https://skycloud.luksarna.com/oauth2/callback"
      ],
      "webOrigins": ["+"],
      "defaultClientScopes": ["email", "profile", "roles", "web-origins", "acr"],
      "protocolMappers": [
        {
          "name": "sky-backend-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "sky-backend",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "owner",
      "enabled": true,
      "emailVerified": true,
      "email": "owner@sky.dev",
      "firstName": "Demo",
      "lastName": "Owner",
      "credentials": [
        { "type": "password", "value": "owner", "temporary": false }
      ],
      "realmRoles": ["admin", "user"]
    },
    {
      "username": "user",
      "enabled": true,
      "emailVerified": true,
      "email": "user@sky.dev",
      "firstName": "Demo",
      "lastName": "User",
      "credentials": [
        { "type": "password", "value": "user", "temporary": false }
      ],
      "realmRoles": ["user"]
    },
    {
      "username": "lukk",
      "enabled": true,
      "emailVerified": true,
      "email": "lukk@sky.dev",
      "firstName": "Lukk",
      "lastName": "Sarna",
      "credentials": [
        { "type": "password", "value": "test1234", "temporary": false }
      ],
      "realmRoles": ["admin", "user"]
    }
  ]
}
