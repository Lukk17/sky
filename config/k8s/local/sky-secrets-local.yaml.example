---
# Local development credentials template. Copy to sky-secrets-local.yaml and fill
# every value with a per-machine random secret (see config/k8s/local_README.md step 4).
# The real file is gitignored and must never be committed.
apiVersion: v1
kind: Secret
metadata:
  name: sky-secrets
  namespace: default
type: Opaque
stringData:
  postgres-user: "postgres"
  postgres-password: "REPLACE_WITH_RANDOM_32_HEX"
  s3-access-key: "REPLACE_WITH_RANDOM_16_HEX"
  s3-secret-key: "REPLACE_WITH_RANDOM_32_HEX"
  keycloak-admin: "admin"
  keycloak-admin-password: "REPLACE_WITH_RANDOM_24_HEX"
  keycloak-db-user: "keycloak_user"
  keycloak-db-password: "REPLACE_WITH_RANDOM_32_HEX"
  keycloak-client-id: "sky-backend"
  keycloak-client-secret: "REPLACE_WITH_RANDOM_32_HEX"
  keycloak-client-cookie-secret: "REPLACE_WITH_RANDOM_32_BYTES"
